{
  "info": {
    "name": "LoanEx EMI Dashboard",
    "description": "Customer loan dashboard and Admin loan management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "loanId", "value": "" }
  ],
  "item": [
    {
      "name": "Current Loan",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/loans/current"
      },
      "response": [
        {
          "name": "Loan Found",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"loanAccountNumber\": \"LX-LN-20260730-0001\",\n    \"loanStatus\": \"ACTIVE\"\n  }\n}"
        },
        {
          "name": "Loan Not Found",
          "status": "Not Found",
          "code": 404,
          "body": "{\n  \"success\": false,\n  \"code\": \"NOT_FOUND\"\n}"
        },
        {
          "name": "Unauthorized",
          "status": "Unauthorized",
          "code": 401,
          "body": "{\n  \"success\": false,\n  \"code\": \"UNAUTHORIZED\"\n}"
        }
      ]
    },
    {
      "name": "EMI Dashboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/loans/dashboard"
      }
    },
    {
      "name": "Payment History",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/loans/payment-history"
      }
    },
    {
      "name": "Download Statement",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/loans/statement"
      }
    },
    {
      "name": "Admin List Loans",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/admin/loans"
      }
    },
    {
      "name": "Admin Get Loan",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/admin/loans/{{loanId}}"
      }
    },
    {
      "name": "Admin Pause Loan",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"loanStatus\": \"PAUSED\",\n  \"remarks\": \"Paused by admin\"\n}"
        },
        "url": "{{baseUrl}}/admin/loans/{{loanId}}"
      }
    }
  ]
}
