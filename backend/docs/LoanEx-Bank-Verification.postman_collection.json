{
  "info": {
    "name": "LoanEx Bank Statement Verification",
    "description": "IDSPay Bank Statement Analysis — PDF upload + fetch",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "clientId", "value": "" }
  ],
  "item": [
    {
      "name": "Bank Status",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/verification/bank/status"
      }
    },
    {
      "name": "Upload Bank Statement PDF",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": [],
              "description": "Bank statement PDF"
            }
          ]
        },
        "url": "{{baseUrl}}/verification/bank/upload"
      }
    },
    {
      "name": "Fetch Statement Details",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_id\": \"{{clientId}}\"\n}"
        },
        "url": "{{baseUrl}}/verification/bank/fetch"
      }
    }
  ]
}
