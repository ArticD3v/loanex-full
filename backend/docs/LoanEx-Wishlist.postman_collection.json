{
  "info": {
    "name": "LoanEx Wishlist",
    "description": "Wishlist APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "productId", "value": "hp-pavilion-15" },
    { "key": "wishlistItemId", "value": "" }
  ],
  "item": [
    {
      "name": "Get Wishlist",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/wishlist"
      },
      "response": [{ "name": "Unauthorized", "status": "Unauthorized", "code": 401 }]
    },
    {
      "name": "Add to Wishlist",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\"\n}"
        },
        "url": "{{baseUrl}}/wishlist"
      }
    },
    {
      "name": "Wishlist Status",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/wishlist/status/{{productId}}"
      }
    },
    {
      "name": "Move to Cart",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/wishlist/{{wishlistItemId}}/move-to-cart"
      }
    },
    {
      "name": "Remove Item",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/wishlist/{{wishlistItemId}}"
      }
    }
  ]
}
