  encryptedPassword        String?                @db.VarChar(255)
  emailConfirmedAt         DateTime?              @db.Timestamptz(6)
  invitedAt                DateTime?              @db.Timestamptz(6)
  confirmationToken        String?                @db.VarChar(255)
  confirmationSentAt       DateTime?              @db.Timestamptz(6)
