  users                 users            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([not_after(sort: Desc)])
  @@index([oauthClientId])
  @@index([userId])
  @@index([userId, createdAt], map: "user_id_created_at_idx")
  @@schema("auth")
}

