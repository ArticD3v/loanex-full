  keywords                      String?
  landingCost                   Decimal?            @db.Decimal(10, 2)
  length                        Decimal?            @db.Decimal(10, 2)
  margin                        Decimal?            @db.Decimal(10, 2)
  marketLowestPrice             Decimal?            @db.Decimal(10, 2)
  maxDownPayment                Decimal?            @db.Decimal(10, 2)
  maxQuantityPerCustomer        Int?
  maximumDiscountAllowed        Decimal?            @db.Decimal(10, 2)
  maximumQuantity               Int?
  metaDescription               String?
  metaTitle                     String?
  minCustomerDownPayment        Decimal?            @db.Decimal(10, 2)
  minOrderQuantity              Int?                @default(1)
  minimumCustomerAge            Int?
  minimumQuantity               Int?                @default(1)
  modelNumber                   String?
  openingStock                  Int?                @default(0)
  otherWebsitePrice             Decimal?            @db.Decimal(10, 2)
  priceCheckedBy                String?
  priceCheckedDate              DateTime?           @db.Timestamptz(6)
  priceMatchAllowed             Boolean?            @default(false)
  productCondition              String?
  productType                   String?
  productVideoUrl               String?
  purchasePrice                 Decimal?            @db.Decimal(10, 2)
  replacementDays               Int?
  replacementWindow             Boolean?            @default(false)
  requiresFieldVerification     Boolean?            @default(false)
  requiresSerialImeiCapture     Boolean?            @default(false)
  reservedStock                 Int?                @default(0)
  selectedEmiPlanId             String?             @db.Uuid
  serialImeiCaptureAtDelivery   Boolean?            @default(false)
  serialImeiTracking            Boolean?            @default(false)
  serviceChargeMethod           String?
  slug                          String?             @unique
  specifications                Json?
  subCategoryId                 String?             @db.Uuid
  trackInventory                Boolean?            @default(true)
  verificationCharge            Decimal?            @db.Decimal(10, 2)
  warehouseId                   String?             @db.Uuid
  weight                        Decimal?            @db.Decimal(10, 2)
  width                         Decimal?            @db.Decimal(10, 2)
  orderItems                    order_items[]
  productEmiPlans               product_emi_plans[]
  productSuppliers              product_suppliers[]
  categories                    categories?         @relation(fields: [categoryId], references: [id], onUpdate: NoAction)

  cart_items      cart_items[]
  product_dealers product_dealers[]
  product_photos  product_photos[]
  reviews         reviews[]
  wishlist_items  wishlist_items[]

  @@schema("public")
}

model product_emi_plans {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  planName             String?
  months               Int?
  downPayment          Decimal? @db.Decimal(10, 2)
  serviceCharge        Decimal? @db.Decimal(10, 2)
  deliveryCharge       Decimal? @db.Decimal(10, 2)
  minEligibilityAmount Decimal? @db.Decimal(10, 2)
  customerVisibility   String?  @default("visible")
  products             products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model profiles {
